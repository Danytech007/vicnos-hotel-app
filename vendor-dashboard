<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Vicnos - Vendor Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
  </style>
</head>
<body class="min-h-screen pb-10">

  <nav class="bg-slate-900 p-5 shadow-sm flex justify-between items-center sticky top-0 z-50">
    <div class="flex items-center gap-3">
      <div class="bg-blue-500/20 p-2 rounded-xl text-blue-400">
        <i data-lucide="store" class="w-6 h-6"></i>
      </div>
      <div>
        <h1 id="vendor-name" class="font-bold text-white text-lg leading-tight">Vendor Name</h1>
        <p class="text-[10px] text-blue-400 uppercase tracking-widest font-bold">Partner Portal</p>
      </div>
    </div>
    <button onclick="logout()" class="bg-slate-800 p-2 rounded-full text-slate-300 hover:bg-slate-700 transition"><i data-lucide="log-out" class="w-5 h-5"></i></button>
  </nav>

  <main class="p-4 max-w-2xl mx-auto space-y-5 mt-4">
    
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="font-bold text-gray-800 mb-4 flex items-center gap-2">
        <i data-lucide="bell" class="w-5 h-5 text-orange-500"></i> Incoming Inquiries (Ghosting Tracker)
      </h2>
      <div id="inquiry-list" class="space-y-3">
        <p class="text-center text-gray-500 text-sm">No new inquiries.</p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="font-bold text-gray-800 mb-4 flex items-center gap-2">
        <i data-lucide="receipt" class="w-5 h-5 text-green-600"></i> Create Custom Invoice
      </h2>
      <p class="text-xs text-gray-500 mb-3">If a guest negotiated on WhatsApp, enter the agreed price here.</p>
      
      <form id="invoice-form" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Select Inquiry</label>
          <select id="invoice-inquiry" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500">
            <option value="">-- Select a guest inquiry --</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Item/Service</label>
              <input id="invoice-item" type="text" required placeholder="e.g. Taxi to Airport" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Agreed Price (₦)</label>
              <input id="invoice-price" type="number" required placeholder="e.g. 15000" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500">
            </div>
        </div>
        <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-xl font-bold shadow-md active:scale-95 transition">Send Invoice to Guest</button>
      </form>
      <p id="msg" class="mt-2 text-center text-sm font-bold text-green-600"></p>
    </div>

    <div class="mt-10 pt-6 text-center border-t border-gray-200">
      <p class="text-[10px] text-gray-400 tracking-wider">Vicnos HotelStack &copy; 2026</p>
      <p class="text-xs font-bold text-gray-500 tracking-widest mt-1">POWERED BY DEKY</p>
    </div>

  </main>

  <script>
    const SUPABASE_URL = 'https://yphhfnbzgexwkzaoiokf.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlwaGhmbmJ6Z2V4d2t6YW9pb2tmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI3Mzk2MjcsImV4cCI6MjEwODMxNTYyN30.jux_BYQ2ZxMQyArrnhNtbRT8cuBD3BM-FVrMq1lIWFU';
    const { createClient } = supabase;
    const db = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    lucide.createIcons();

    let currentVendorId = null;

    async function loadVendorData() {
        const { data: { user } } = await db.auth.getUser();
        if (!user) { window.location.href = 'index.html'; return; }

        // Get the vendor profile linked to this user
        const { data: profile } = await db.from('profiles').select('vendor_id, full_name').eq('id', user.id).single();
        
        if (!profile || !profile.vendor_id) {
            alert("Your account is not linked to a vendor profile. Contact Super Admin.");
            return;
        }

        currentVendorId = profile.vendor_id;
        document.getElementById('vendor-name').textContent = profile.full_name;

        loadInquiries();
    }

    async function loadInquiries() {
        const list = document.getElementById('inquiry-list');
        const select = document.getElementById('invoice-inquiry');

        const { data: inquiries } = await db.from('vendor_inquiries')
            .select('*')
            .eq('vendor_id', currentVendorId)
            .eq('status', 'Unconverted')
            .order('created_at', { ascending: false });

        if (!inquiries || inquiries.length === 0) {
            list.innerHTML = '<p class="text-center text-gray-500 text-sm py-4">No pending inquiries. Keep up the good work!</p>';
            select.innerHTML = '<option value="">No pending inquiries</option>';
            return;
        }

        // Populate List
        list.innerHTML = inquiries.map(inq => `
            <div class="flex justify-between items-center bg-gray-50 p-3 rounded-xl border">
                <div>
                    <p class="font-bold text-gray-800 text-sm">Room ${inq.guest_room}</p>
                    <p class="text-[10px] text-gray-500">${new Date(inq.created_at).toLocaleString()}</p>
                </div>
                <span class="bg-yellow-100 text-yellow-800 text-[10px] font-bold px-2 py-1 rounded">Waiting for Reply</span>
            </div>
        `).join('');

        // Populate Dropdown
        select.innerHTML = '<option value="">-- Select a guest inquiry --</option>';
        inquiries.forEach(inq => {
            select.innerHTML += `<option value="${inq.id}">Room ${inq.guest_room} - ${new Date(inq.created_at).toLocaleTimeString()}</option>`;
        });
    }

    document.getElementById('invoice-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('msg');
        msg.textContent = "Sending...";

        const inquiryId = document.getElementById('invoice-inquiry').value;
        const item = document.getElementById('invoice-item').value;
        const price = parseFloat(document.getElementById('invoice-price').value);

        // 1. Create the order (Escrow status)
        const { error: orderError } = await db.from('vendor_orders').insert({
            vendor_id: currentVendorId,
            inquiry_id: inquiryId,
            order_details: item,
            total_amount: price,
            commission_amount: price * 0.15, // 15% commission
            status: 'Pending Payment'
        });

        if (orderError) {
            msg.textContent = "Error: " + orderError.message;
            return;
        }

        // 2. Mark inquiry as converted
        await db.from('vendor_inquiries').update({ status: 'Converted' }).eq('id', inquiryId);

        msg.textContent = "✅ Invoice Sent to Guest! They will receive a prompt to pay.";
        document.getElementById('invoice-form').reset();
        loadInquiries();
    });

    async function logout() { await db.auth.signOut(); window.location.href = 'index.html'; }

    loadVendorData();
  </script>
</body>
</html>